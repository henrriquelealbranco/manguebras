# URL pública do site (produção)
NEXT_PUBLIC_SITE_URL=https://www.manguebras.com.br

# --- Analytics & Pixels (integrações preparadas) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
